executor {
    name = 'slurm'
}

process {
    beforeScript = 'module load pawseyenv/2025.08 singularity/4.1.0-nompi'
    queue = 'work'
    withName: prepVCF {
        memory = '1GB'
        cpus = 1
        time = '30m'
    }
    withName: cutVCF {
        memory = '1GB'
        cpus = 1
        time = '30m'
    }
    withName: LD {
        memory = '32GB'
        cpus = 1
        time = '2h'
    }
    withName: HaploVar {
        memory = '144GB'
        cpus = 1
        time = '24h'
    }
    withName: concat_haplotypes {
        memory = '8GB'
        cpus = 1
        time = '1h'
    }
}

singularity.enabled = true
